;; title: Deep Recursion — Dragon Curve
;; desc: Tests the trampoline: 12 levels of recursion draw the Dragon fractal
TO DRAGON :SIZE :DEPTH :TURN
  IF :DEPTH = 0 [ FD :SIZE STOP ]
  ; LOCALMAKE: each recursion level needs its own :HALF
  LOCALMAKE "HALF :SIZE / SQRT 2
  DRAGON :HALF :DEPTH - 1 1
  RT 90 * :TURN
  DRAGON :HALF :DEPTH - 1 -1
END

HT
SETWIDTH 1
SETCOLOR 20 60 200
PU SETPOS -40 100 PD
DRAGON 260 12 1
