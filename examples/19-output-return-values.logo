;; title: OUTPUT — Return Values
;; desc: Procedures that return values using OUTPUT
; OUTPUT — Return Values
; Hypotenuse of a right triangle
TO HYPO :A :B
  OUTPUT SQRT (:A * :A + :B * :B)
END
; Square a number
TO SQR :N
  OUTPUT :N * :N
END
; Draw spokes scaled by computed length
REPEAT 12 [
  FD HYPO 60 80
  BK HYPO 60 80
  RT 30
]
