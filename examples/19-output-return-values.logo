;; title: OUTPUT — Return Values
;; desc: Procedures that return values using OUTPUT
;; topic: Procedures
;; shows: OUTPUT
; Hypotenuse of a right triangle
TO HYPO :A :B
  OUTPUT SQRT (:A * :A + :B * :B)
END
; Square a number
TO SQR :N
  OUTPUT :N * :N
END
; Draw spokes scaled by computed length
REPEAT 12 [
  MAKE "L HYPO 90 120   ; compute once, use twice
  FD :L
  BK :L
  RT 30
]
PRINT HYPO 3 4   ; 5
PRINT SQR 12     ; 144
