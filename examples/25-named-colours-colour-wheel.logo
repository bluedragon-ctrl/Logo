;; title: Named Colours — Colour Wheel
;; desc: Six spokes using named colours and LABEL
; Colour wheel — named colours and LABEL
HT SETWIDTH 3
PU HOME PD
SETCOLOR RED     FD 100 LABEL "RED
PU HOME PD SETCOLOR ORANGE  SETHEADING  60 FD 100 LABEL "ORANGE
PU HOME PD SETCOLOR YELLOW  SETHEADING 120 FD 100 LABEL "YELLOW
PU HOME PD SETCOLOR GREEN   SETHEADING 180 FD 100 LABEL "GREEN
PU HOME PD SETCOLOR BLUE    SETHEADING 240 FD 100 LABEL "BLUE
PU HOME PD SETCOLOR PURPLE  SETHEADING 300 FD 100 LABEL "PURPLE
