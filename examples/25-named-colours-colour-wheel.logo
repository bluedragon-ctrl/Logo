;; title: Named Colours — Colour Wheel
;; desc: Six spokes using named colours and LABEL
;; topic: Colour
;; shows: SETCOLOR, LABEL
; Colour wheel — named colours and LABEL
HT SETWIDTH 6
PU HOME PD
SETCOLOR RED     FD 150 LABEL "RED
PU HOME PD SETCOLOR ORANGE  SETHEADING  60 FD 150 LABEL "ORANGE
PU HOME PD SETCOLOR YELLOW  SETHEADING 120 FD 150 LABEL "YELLOW
PU HOME PD SETCOLOR GREEN   SETHEADING 180 FD 150 LABEL "GREEN
PU HOME PD SETCOLOR BLUE    SETHEADING 240 FD 150 LABEL "BLUE
PU HOME PD SETCOLOR PURPLE  SETHEADING 300 FD 150 LABEL "PURPLE
