;; title: REPCOUNT — Expanding Spiral
;; desc: REPCOUNT gives the current iteration number (1..n) inside REPEAT
;; topic: Loops
;; shows: REPCOUNT
; Each side is REPCOUNT * 3 long, so the triangle spiral grows;
; the colour fades from blue to red as REPCOUNT counts up
SETWIDTH 2
REPEAT 70 [
  SETCOLOR REPCOUNT * 3 40 255 - REPCOUNT * 3
  FD REPCOUNT * 3
  RT 121
]
