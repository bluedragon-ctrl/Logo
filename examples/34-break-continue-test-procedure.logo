;; title: BREAK, CONTINUE and a Test
;; desc: A procedure that OUTPUTs 1 or 0 answers a question; CONTINUE skips a round, BREAK ends the loop
;; topic: Variables and decisions
;; shows: OUTPUT, BREAK, CONTINUE
; EVEN? answers "is :N even?" with 1 (yes) or 0 (no)
TO EVEN? :N
  OUTPUT :N MOD 2 = 0
END
; A bar for every even number — stop at the first one that is a multiple of 7
SETWIDTH 12
FOR :I 1 30 [
  IF NOT EVEN? :I [ CONTINUE ]           ; odd: skip to the next :I
  PU SETPOS -220 + :I * 30 -150
  IF :I MOD 7 = 0 [ LABEL :I BREAK ]     ; found it: write it and leave the loop
  SETCOLOR 40 :I * 15 200
  PD SETPOS XCOR -150 + :I * 15
]
