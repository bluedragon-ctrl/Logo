;; title: Graphs — Parabola and Hyperbola
;; desc: SETPLOT chooses the range, AXES draws the axes, PLOT draws y = x² - 2 and y = 1 / x
;; topic: Maths and curves
;; shows: SETPLOT, AXES, PLOT
SPEED 4
SETPLOT -4 4 -3 5           ; x from -4 to 4, y from -3 to 5
SETCOLOR GRAY
AXES 1 1                    ; a tick and a number every 1

; Parabola y = x * x - 2
SETCOLOR BLUE SETWIDTH 2
PU                          ; jump to the first point
FOR :X -4 4 0.05 [
  PLOT :X :X * :X - 2
  PD                        ; draw from the second point on
]

; Hyperbola y = 1 / x — x = 0 would divide by zero, so skip it.
; Points outside the range break the line, so the two halves stay apart.
SETCOLOR RED
PU
FOR :X -4 4 0.05 [
  IF :X <> 0 [ PLOT :X 1 / :X PD ]
]
PU HOME HT
